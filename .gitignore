.env
*.pyc
__pycache__/
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# runtime data — regenerated daily, never commit
data/*.csv
data/*.db
data/*.db-journal
data/*.db.*
data/*.sqlite
data/*.sqlite-*
data/.token.json
data/.angel_session.json
data/*.json
data/warmup/
logs/
HALT

# Derived from the scrip master; rebuilt on demand.
data/*.filtered.json

# SSH keys. A private key in a public repo is full access to the server that
# holds ANGEL_MPIN and ANGEL_TOTP_SECRET -- which together are full access to
# a real trading account. Belt and braces: these should live in ~/.ssh, not
# here, but if one lands in this directory git must never see it.
*.key
*.pem
id_rsa*
id_ed25519*
*.ppk
*.pub
