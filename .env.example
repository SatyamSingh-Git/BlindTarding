# Copy to .env and fill in. Never commit .env.

# --- Dhan credentials ---------------------------------------------------
# web.dhan.co -> Profile -> DhanHQ Trading APIs
# On that page, toggle the switch (top right) from "API Key" to "Access Token".
# The API Key flow is a three-step OAuth consent dance meant for multi-user
# apps and needs a Redirect URL; you want the direct token.
DHAN_CLIENT_ID=1000000000
DHAN_ACCESS_TOKEN=

# IMPORTANT: Dhan access tokens expire after 24 HOURS. A static token above
# means the bot stops working every morning. For unattended running, set up
# TOTP on the same Dhan API page ("Add TOTP") and fill in the two values below
# so the bot can mint its own token before the old one expires.
#
# DHAN_TOTP_SECRET is the base32 secret shown next to the QR code, NOT the
# 6-digit code from your authenticator app.
DHAN_PIN=
DHAN_TOTP_SECRET=

# --- Static IP proxy (Decodo) -------------------------------------------
# Dhan REQUIRES static-IP whitelisting for order placement/modify/cancel.
# Must be a DEDICATED STATIC IP, not a rotating residential pool.
# Leave blank to call Dhan directly (only works if this machine already has
# a static IP whitelisted with Dhan).
# Format: http://user:pass@host:port
DHAN_ORDER_PROXY=

# Data APIs (historical, feed) do NOT require the static IP. Routing them
# through the proxy adds latency for no benefit — leave this false.
PROXY_DATA_CALLS=false

# --- Telegram alerts ----------------------------------------------------
# Create a bot via @BotFather, then get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Runtime ------------------------------------------------------------
# paper = simulate fills, never send a real order. live = real money.
TRADE_MODE=paper
LOG_LEVEL=INFO
