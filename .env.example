# Copy to .env and fill in. Never commit .env.

# --- Which broker? ------------------------------------------------------
# dhan  = market data costs Rs.499+GST/month; native intervals 1/5/15/25/60m
# angel = market data FREE; native intervals 1/3/5/10/15/30/60m (more of the
#         5m-2D range is exchange-aggregated, so more of it is directly
#         verifiable against your chart)
#
# WARNING: the two brokers use DIFFERENT ids for the same contract. Dhan's
# NIFTY is securityId 13; Angel's is token 99926000. After switching you MUST
# re-resolve every security_id in config/instruments.yaml. `orbot validate`
# refuses to run if it spots the other broker's ids.
BROKER=dhan

# --- Dhan credentials ---------------------------------------------------
# web.dhan.co -> Profile -> DhanHQ Trading APIs
# On that page, toggle the switch (top right) from "API Key" to "Access Token".
# The API Key flow is a three-step OAuth consent dance meant for multi-user
# apps and needs a Redirect URL; you want the direct token.
DHAN_CLIENT_ID=1000000000
DHAN_ACCESS_TOKEN=

# IMPORTANT: Dhan access tokens expire after 24 HOURS. A static token above
# means the bot stops working every morning. For unattended running, set up
# TOTP on the same Dhan API page ("Add TOTP") and fill in the two values below
# so the bot can mint its own token before the old one expires.
#
# DHAN_TOTP_SECRET is the base32 secret shown next to the QR code, NOT the
# 6-digit code from your authenticator app.
DHAN_PIN=
DHAN_TOTP_SECRET=

# --- Angel One SmartAPI -------------------------------------------------
# Create a free app at https://smartapi.angelone.in to get the API key.
# ANGEL_MPIN is your 4-digit trading PIN. ANGEL_TOTP_SECRET is the base32
# secret from the QR code you scanned, not a 6-digit code.
ANGEL_CLIENT_CODE=
ANGEL_API_KEY=
ANGEL_MPIN=
ANGEL_TOTP_SECRET=

# --- Static IP proxy (Decodo) -------------------------------------------
# Dhan REQUIRES static-IP whitelisting for order placement/modify/cancel.
# Must be a DEDICATED STATIC IP, not a rotating residential pool.
# Leave blank to call Dhan directly (only works if this machine already has
# a static IP whitelisted with Dhan).
# Format: http://user:pass@host:port
DHAN_ORDER_PROXY=

# Data APIs (historical, feed) do NOT require the static IP. Routing them
# through the proxy adds latency for no benefit — leave this false.
PROXY_DATA_CALLS=false

# --- Telegram alerts ----------------------------------------------------
# Create a bot via @BotFather, then get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Runtime ------------------------------------------------------------
# paper = simulate fills, never send a real order. live = real money.
TRADE_MODE=paper

# Fake starting capital for paper mode. No money moves anywhere — this is what
# the simulated broker reports as your balance, so the funds guard and position
# sizing behave as they will with real capital. Set it to what you actually
# intend to trade with, or the paper run will not tell you much.
PAPER_CAPITAL=200000
PAPER_SLIPPAGE_PCT=0.05
LOG_LEVEL=INFO
